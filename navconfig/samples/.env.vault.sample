# --- navconfig:vault --- managed by `kardex vault create`, do not rename
# NavConfig -- HashiCorp Vault configuration.
# NavConfig reads these directives from the base "env/<environment>/.env"
# file, connects to Vault and merges the secrets stored under
# <VAULT_MOUNT_POINT>/<environment>/ on top of the file-based values.

# Enable the Vault loader (true/false).
VAULT_ENABLED=true

# Address of the Vault server.
VAULT_URL=http://localhost:8200

# Token used to authenticate against Vault.
VAULT_TOKEN=

# KV mount point holding the application secrets.
VAULT_MOUNT_POINT=navigator

# KV engine version (1 or 2).
VAULT_VERSION=2

# Optional: read secrets from a different path segment than ENV.
# Only Vault lookups are affected; file loading keeps using ENV.
# VAULT_ENV=

# Optional: when true, .env files override the values coming from Vault.
# NAVCONFIG_FILE_OVERRIDE_ENABLED=false
# --- navconfig:vault:end ---
