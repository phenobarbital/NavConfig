# NavConfig -- API configuration.
# Non-secret directives for the HTTP layer.

# Interface and port the application binds to.
API_HOST=0.0.0.0
API_PORT=5000

# Request timeout, in seconds.
API_TIMEOUT=60

# Comma-separated list, read back with config.getlist("ALLOWED_HOSTS").
ALLOWED_HOSTS=localhost,127.0.0.1

# Base URL of the API, used to build absolute links.
API_BASE_URL=http://localhost:5000
