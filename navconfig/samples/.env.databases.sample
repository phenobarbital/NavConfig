# NavConfig -- Database configuration.
# Connection settings for the databases used by the application.
# Credentials belong in HashiCorp Vault whenever possible.

# -- PostgreSQL --
DBHOST=localhost
DBPORT=5432
DBNAME=navigator
DBUSER=
DBPWD=

# Optional full DSN. When set it takes precedence over the values above.
# DATABASE_URL=postgresql://user:password@localhost:5432/navigator

# Connection pool sizing.
DB_MIN_SIZE=2
DB_MAX_SIZE=10
